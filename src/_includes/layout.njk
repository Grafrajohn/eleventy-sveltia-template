<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description | default('') | escape }}">
    <title>{{ title | escape }} | Fieldnotes</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous">
    <link href="/assets/css/site.css" rel="stylesheet">
  </head>
  <body>
    <header class="border-bottom">
      <nav class="container navbar py-3" aria-label="Main navigation">
        <a class="navbar-brand fw-semibold" href="/">Eleventy Sveltia Template</a>
        <div class="d-flex gap-3">
          <a class="nav-link" href="/about">About</a>
          <a class="nav-link" href="/information">Information</a>
          <a class="nav-link" href="/posts/">Blog</a>
        </div>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="container py-4 mt-5 border-top text-body-secondary">
      <p class="mb-0">&copy; {{ year }} Fieldnotes. Made for the curious.</p>
    </footer>
  </body>
</html>
