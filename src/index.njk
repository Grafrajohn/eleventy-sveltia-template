---
layout: layout.njk
title: Welcome
description: A clean, simple starting point for your next idea.
---
<section class="hero py-5 py-lg-6">
  <div class="container py-4">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <p class="text-uppercase fw-semibold text-primary small letter-spacing">{{ home.hero.eyebrow | escape }}</p>
        <h1 class="display-3 fw-bold">{{ home.hero.heading | escape }} <span class="text-primary">{{ home.hero.headingAccent | escape }}</span></h1>
        <p class="lead text-body-secondary mt-3">
          {{ home.hero.introduction | escape }}
        </p>
        <a class="btn btn-primary btn-lg mt-3" href="#highlights">{{ home.hero.button | escape }}</a>
      </div>
      <div class="col-lg-5">
        <div class="hero-card p-4 p-md-5 rounded-4 shadow-sm">
          <span class="badge rounded-pill text-bg-primary mb-3">{{ home.hero.cardBadge | escape }}</span>
          <h2 class="h3 fw-semibold">{{ home.hero.cardHeading | escape }}</h2>
          <p class="mb-0 text-body-secondary">
            {{ home.hero.cardText | escape }}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="about" class="container py-5">
  <div class="row justify-content-center text-center">
    <div class="col-lg-8">
      <h2 class="fw-bold">{{ home.about.heading | escape }}</h2>
      <p class="text-body-secondary mt-3 mb-0">
        {{ home.about.text | escape }}
      </p>
    </div>
  </div>
</section>

<section id="highlights" class="container py-5">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-2 mb-4">
    <div>
      <p class="text-uppercase fw-semibold text-primary small letter-spacing mb-2">{{ home.highlights.eyebrow | escape }}</p>
      <h2 class="fw-bold mb-0">{{ home.highlights.heading | escape }}</h2>
    </div>
    <p class="text-body-secondary mb-0">{{ home.highlights.introduction | escape }}</p>
  </div>
  <div class="row g-4">
    {% for card in home.highlights.cards %}
    <div class="col-md-4">
      <article class="card h-100 border-0 shadow-sm">
        <div class="card-body p-4">
          <div class="feature-icon mb-3">0{{ loop.index }}</div>
          <h3 class="h5 card-title fw-semibold">{{ card.heading | escape }}</h3>
          <p class="card-text text-body-secondary">{{ card.text | escape }}</p>
        </div>
      </article>
    </div>
    {% endfor %}
  </div>
</section>

